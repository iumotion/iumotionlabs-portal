---
const pillars = [
  {
    number: '01',
    title: 'Innovación',
    subtitle: 'Anticipamos el futuro',
    description: 'Exploramos tecnologías emergentes antes de que sean mainstream. Cada decisión técnica considera hacia dónde va la industria, no dónde está.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`,
    gradient: 'from-violet-500 to-purple-600',
    color: 'violet'
  },
  {
    number: '02',
    title: 'Seguridad',
    subtitle: 'El fundamento, no un feature',
    description: 'Cada línea de código considera la protección de datos. Privacy by design, encryption por defecto, zero-trust architecture.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>`,
    gradient: 'from-emerald-500 to-teal-600',
    color: 'emerald'
  },
  {
    number: '03',
    title: 'Escalabilidad',
    subtitle: 'Diseñado para millones',
    description: 'Arquitecturas que escalan horizontalmente. Event-driven, microservicios, serverless cuando tiene sentido. El primer usuario y el millonésimo tienen la misma experiencia.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>`,
    gradient: 'from-blue-500 to-cyan-600',
    color: 'blue'
  },
  {
    number: '04',
    title: 'Diseño',
    subtitle: 'Experiencias memorables',
    description: 'Interfaces que enamoran y funcionan. Design systems consistentes, micro-interacciones cuidadas, accesibilidad como estándar no como checkbox.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>`,
    gradient: 'from-pink-500 to-rose-600',
    color: 'pink'
  },
  {
    number: '05',
    title: 'Velocidad',
    subtitle: 'Valor rápido, calidad constante',
    description: 'Iteraciones cortas, feedback constante, mejora continua. CI/CD automatizado, feature flags, deploys sin downtime. Ship fast, learn faster.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
    gradient: 'from-amber-500 to-orange-600',
    color: 'amber'
  }
];
---

<section id="enfoque" class="py-24 lg:py-32 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-[var(--color-surface-primary)]"></div>

  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Gradient orbs -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-gradient-to-br from-violet-500/10 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-full blur-3xl"></div>

    <!-- Code-like decorative lines -->
    <div class="absolute top-20 left-10 text-[var(--color-border)] text-xs font-mono opacity-20 select-none">
      const innovation = () => {'{'}<br/>
      &nbsp;&nbsp;return future;<br/>
      {'}'};
    </div>
    <div class="absolute bottom-20 right-10 text-[var(--color-border)] text-xs font-mono opacity-20 select-none text-right">
      {'{'} quality: true,<br/>
      &nbsp;&nbsp;scale: "infinite" {'}'}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="max-w-3xl mb-20 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-surface-secondary)]/80 backdrop-blur border border-[var(--color-border)] mb-6">
        <svg class="w-4 h-4 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <span class="text-sm font-medium text-[var(--color-text-secondary)]">Filosofía de Construcción</span>
      </div>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-6">
        Principios que
        <span class="relative inline-block">
          <span class="gradient-text">definen</span>
          <svg class="absolute -bottom-1 left-0 w-full" viewBox="0 0 100 8" preserveAspectRatio="none">
            <path d="M0 4 Q50 8 100 4" fill="none" stroke="url(#underline-gradient)" stroke-width="3" stroke-linecap="round"/>
            <defs>
              <linearGradient id="underline-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color:#6366f1"/>
                <stop offset="100%" style="stop-color:#8b5cf6"/>
              </linearGradient>
            </defs>
          </svg>
        </span>
        <br/>cada decisión
      </h2>
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)]">
        No son solo palabras. Son compromisos verificables en cada commit, cada PR, cada deploy.
      </p>
    </div>

    <!-- Pillars - Asymmetric Bento Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">

      <!-- Innovation - Large card -->
      <div class="lg:col-span-2 lg:row-span-2 group reveal">
        <div class="relative h-full p-8 lg:p-10 rounded-3xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)] overflow-hidden transition-all duration-300 hover:border-violet-500/30">
          <!-- Background glow -->
          <div class="absolute top-0 right-0 w-80 h-80 bg-gradient-to-bl from-violet-500/10 to-transparent rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="relative">
            <!-- Number -->
            <div class="text-8xl lg:text-9xl font-bold text-[var(--color-border-subtle)] absolute -top-4 -left-2 select-none">01</div>

            <div class="relative pt-12 lg:pt-16">
              <!-- Icon -->
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center mb-6 shadow-lg shadow-violet-500/25 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>

              <h3 class="text-2xl lg:text-3xl font-bold text-[var(--color-text-primary)] mb-2">Innovación</h3>
              <p class="text-violet-500 font-medium mb-4">Anticipamos el futuro</p>
              <p class="text-[var(--color-text-secondary)] text-lg leading-relaxed max-w-xl">
                Exploramos tecnologías emergentes antes de que sean mainstream. Cada decisión técnica considera hacia dónde va la industria, no dónde está.
              </p>

              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2 mt-6">
                <span class="px-3 py-1 rounded-full bg-violet-500/10 text-violet-500 text-sm">AI/ML</span>
                <span class="px-3 py-1 rounded-full bg-violet-500/10 text-violet-500 text-sm">Edge Computing</span>
                <span class="px-3 py-1 rounded-full bg-violet-500/10 text-violet-500 text-sm">Web3</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Security -->
      <div class="group reveal">
        <div class="relative h-full p-6 lg:p-8 rounded-3xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)] overflow-hidden transition-all duration-300 hover:border-emerald-500/30">
          <div class="absolute -top-2 -right-2 text-6xl font-bold text-[var(--color-border-subtle)] select-none">02</div>

          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mb-4 shadow-lg shadow-emerald-500/25 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
              </svg>
            </div>

            <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-1">Seguridad</h3>
            <p class="text-emerald-500 text-sm font-medium mb-3">El fundamento, no un feature</p>
            <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
              Privacy by design, encryption por defecto, zero-trust architecture.
            </p>
          </div>
        </div>
      </div>

      <!-- Scalability -->
      <div class="group reveal">
        <div class="relative h-full p-6 lg:p-8 rounded-3xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)] overflow-hidden transition-all duration-300 hover:border-blue-500/30">
          <div class="absolute -top-2 -right-2 text-6xl font-bold text-[var(--color-border-subtle)] select-none">03</div>

          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center mb-4 shadow-lg shadow-blue-500/25 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
              </svg>
            </div>

            <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-1">Escalabilidad</h3>
            <p class="text-blue-500 text-sm font-medium mb-3">Diseñado para millones</p>
            <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
              Event-driven, microservicios, serverless cuando tiene sentido.
            </p>
          </div>
        </div>
      </div>

      <!-- Design -->
      <div class="md:col-span-2 lg:col-span-1 group reveal">
        <div class="relative h-full p-6 lg:p-8 rounded-3xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)] overflow-hidden transition-all duration-300 hover:border-pink-500/30">
          <div class="absolute -top-2 -right-2 text-6xl font-bold text-[var(--color-border-subtle)] select-none">04</div>

          <div class="relative">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center mb-4 shadow-lg shadow-pink-500/25 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/>
              </svg>
            </div>

            <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-1">Diseño</h3>
            <p class="text-pink-500 text-sm font-medium mb-3">Experiencias memorables</p>
            <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
              Design systems consistentes, micro-interacciones cuidadas, accesibilidad como estándar.
            </p>
          </div>
        </div>
      </div>

      <!-- Speed - Wide card -->
      <div class="md:col-span-2 group reveal">
        <div class="relative h-full p-6 lg:p-8 rounded-3xl bg-gradient-to-br from-amber-500/5 to-orange-500/5 border border-amber-500/20 overflow-hidden transition-all duration-300 hover:border-amber-500/40">
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-amber-500/10 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>

          <div class="relative flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex items-center gap-4">
              <div class="text-7xl font-bold text-amber-500/20 select-none">05</div>
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg shadow-amber-500/25 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
                </svg>
              </div>
            </div>

            <div class="flex-1">
              <h3 class="text-xl lg:text-2xl font-bold text-[var(--color-text-primary)] mb-1">Velocidad</h3>
              <p class="text-amber-500 font-medium mb-2">Valor rápido, calidad constante</p>
              <p class="text-[var(--color-text-secondary)] leading-relaxed">
                Iteraciones cortas, CI/CD automatizado, feature flags, deploys sin downtime. Ship fast, learn faster.
              </p>
            </div>

            <!-- Metric -->
            <div class="text-center md:text-right">
              <div class="text-4xl font-bold gradient-text">&lt;5min</div>
              <div class="text-sm text-[var(--color-text-muted)]">Deploy to prod</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="mt-20 text-center reveal">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-6 rounded-3xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)]">
        <p class="text-[var(--color-text-secondary)]">
          ¿Compartes nuestra visión de construir productos excepcionales?
        </p>
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl gradient-bg text-white font-semibold hover:shadow-lg hover:shadow-violet-500/25 hover:scale-105 transition-all"
        >
          Hablemos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
