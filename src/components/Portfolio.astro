---
const projects = [
  {
    name: 'SAVVY',
    tagline: 'Tu copiloto financiero personal',
    type: 'App Móvil',
    status: 'launchpad',
    statusLabel: 'Launchpad',
    statusDesc: 'Próximo a lanzar',
    description: 'Toma el control de tus finanzas con inteligencia y privacidad. Funciona offline, sincroniza cuando quieras.',
    highlights: [
      'Categorización inteligente de gastos',
      'Metas de ahorro visuales',
      'Arquitectura offline-first',
      'Sincronización cloud segura',
      'Flutter + Firebase'
    ],
    tech: ['Flutter', 'Firebase', 'Riverpod'],
    ctaText: 'Próximamente',
    gradient: 'from-emerald-500 to-teal-600',
    glowColor: 'rgba(16, 185, 129, 0.3)',
    iconBg: 'bg-emerald-500/10',
    iconColor: 'text-emerald-500'
  },
  {
    name: 'MYTHOS',
    tagline: 'Donde las ideas se convierten en historias',
    type: 'Ecosistema',
    status: 'building',
    statusLabel: 'Building',
    statusDesc: 'En desarrollo activo',
    description: 'Plataforma de construcción narrativa aplicada a innovación. Transforma ideas en proyectos ejecutables.',
    highlights: [
      'De idea a Canon con IA',
      'Comunidad de validación',
      'Story Arc evolutivo',
      'Agentes: Homero, Calíope, Pythia',
      'Angular + Go + AWS'
    ],
    tech: ['Angular', 'Go', 'AWS', 'PostgreSQL'],
    ctaText: 'Acceso Beta',
    gradient: 'from-amber-500 to-orange-600',
    glowColor: 'rgba(245, 158, 11, 0.3)',
    iconBg: 'bg-amber-500/10',
    iconColor: 'text-amber-500'
  },
  {
    name: 'FAMILY CARE',
    tagline: 'El cuidado de toda tu familia',
    type: 'App Móvil',
    status: 'concept',
    statusLabel: 'Concept Lab',
    statusDesc: 'En ideación',
    description: 'Desde bebés hasta abuelos. Centraliza salud, rutinas y coordinación familiar.',
    highlights: [
      'Perfiles por edad y rol',
      'Seguimiento médico adaptativo',
      'Coordinación en tiempo real',
      'FamilyBot con IA contextual',
      'Offline-first'
    ],
    tech: ['Flutter', 'AI', 'Cloud'],
    ctaText: 'En ideación',
    gradient: 'from-violet-500 to-purple-600',
    glowColor: 'rgba(139, 92, 246, 0.3)',
    iconBg: 'bg-violet-500/10',
    iconColor: 'text-violet-500'
  }
];

const statusIcons = {
  launchpad: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
  building: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>`,
  concept: `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
};
---

<section id="portafolio" class="py-24 lg:py-32 relative overflow-hidden">
  <!-- Animated background -->
  <div class="absolute inset-0 bg-[var(--color-surface-secondary)]"></div>
  <div class="absolute inset-0 opacity-30" aria-hidden="true">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-gradient-to-br from-violet-500/20 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-gradient-to-br from-emerald-500/20 to-transparent rounded-full blur-3xl"></div>
  </div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-20 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-surface-primary)]/80 backdrop-blur border border-[var(--color-border)] mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-violet-500"></span>
        </span>
        <span class="text-sm font-medium text-[var(--color-text-secondary)]">Timeline de Innovación</span>
      </div>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--color-text-primary)] mb-6">
        Construyendo el
        <span class="relative">
          <span class="gradient-text">Futuro</span>
          <svg class="absolute -bottom-2 left-0 w-full h-3 text-violet-500/30" viewBox="0 0 100 12" preserveAspectRatio="none">
            <path d="M0 6 Q 25 0, 50 6 T 100 6" fill="none" stroke="currentColor" stroke-width="3"/>
          </svg>
        </span>
      </h2>
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-3xl mx-auto">
        Tres proyectos. Tres etapas. Una misma visión de productos que transforman realidades.
      </p>
    </div>

    <!-- Timeline connector (desktop) -->
    <div class="hidden lg:block absolute left-1/2 top-80 bottom-32 w-px bg-gradient-to-b from-transparent via-[var(--color-border)] to-transparent"></div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

      <!-- SAVVY - Featured Card (spans 7 cols) -->
      <article class="lg:col-span-7 group relative reveal" data-project="savvy">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-600 rounded-3xl opacity-0 group-hover:opacity-100 blur transition-all duration-500"></div>
        <div class="relative h-full bg-[var(--color-surface-primary)] rounded-3xl border border-[var(--color-border)] overflow-hidden transition-all duration-300 group-hover:border-transparent">
          <!-- Glow effect -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-full blur-3xl transition-opacity duration-500 opacity-50 group-hover:opacity-100"></div>

          <div class="relative p-8 lg:p-10">
            <!-- Header -->
            <div class="flex items-start justify-between mb-6">
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/25">
                    <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-2xl lg:text-3xl font-bold text-[var(--color-text-primary)]">SAVVY</h3>
                    <p class="text-emerald-500 font-medium text-sm">Tu copiloto financiero personal</p>
                  </div>
                </div>
              </div>
              <div class="flex flex-col items-end gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-500 text-xs font-semibold border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Launchpad
                </span>
                <span class="text-xs text-[var(--color-text-muted)]">App Móvil</span>
              </div>
            </div>

            <!-- Description -->
            <p class="text-[var(--color-text-secondary)] text-lg mb-8 leading-relaxed">
              {projects[0].description}
            </p>

            <!-- Highlights as tags/chips -->
            <div class="flex flex-wrap gap-2 mb-8">
              {projects[0].highlights.map(h => (
                <span class="px-3 py-1.5 rounded-lg bg-[var(--color-surface-secondary)] text-sm text-[var(--color-text-secondary)] border border-[var(--color-border-subtle)]">
                  {h}
                </span>
              ))}
            </div>

            <!-- Tech Stack -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                {projects[0].tech.map(t => (
                  <span class="px-2 py-1 rounded bg-emerald-500/10 text-emerald-600 text-xs font-mono">
                    {t}
                  </span>
                ))}
              </div>
              <button disabled class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--color-surface-secondary)] text-[var(--color-text-muted)] font-medium cursor-not-allowed">
                {projects[0].ctaText}
              </button>
            </div>
          </div>

          <!-- Decorative corner -->
          <div class="absolute bottom-0 right-0 w-32 h-32 bg-gradient-to-tl from-emerald-500/5 to-transparent"></div>
        </div>
      </article>

      <!-- Status Legend Card (spans 5 cols) -->
      <div class="lg:col-span-5 reveal">
        <div class="h-full bg-[var(--color-surface-primary)] rounded-3xl border border-[var(--color-border)] p-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-500 via-amber-500 to-violet-500"></div>

          <h4 class="text-lg font-semibold text-[var(--color-text-primary)] mb-6">Estados del Pipeline</h4>

          <div class="space-y-6">
            <!-- Launchpad -->
            <div class="flex items-start gap-4 group/item">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform">
                <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
              </div>
              <div>
                <h5 class="font-semibold text-[var(--color-text-primary)]">Launchpad</h5>
                <p class="text-sm text-[var(--color-text-muted)]">Listo para despegar. Últimos ajustes antes del lanzamiento público.</p>
              </div>
            </div>

            <!-- Building -->
            <div class="flex items-start gap-4 group/item">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform">
                <div class="w-3 h-3 rounded-full bg-amber-500"></div>
              </div>
              <div>
                <h5 class="font-semibold text-[var(--color-text-primary)]">Building</h5>
                <p class="text-sm text-[var(--color-text-muted)]">En construcción activa. Arquitectura definida, desarrollo en progreso.</p>
              </div>
            </div>

            <!-- Concept -->
            <div class="flex items-start gap-4 group/item">
              <div class="w-10 h-10 rounded-xl bg-violet-500/10 flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform">
                <div class="w-3 h-3 rounded-full bg-violet-500"></div>
              </div>
              <div>
                <h5 class="font-semibold text-[var(--color-text-primary)]">Concept Lab</h5>
                <p class="text-sm text-[var(--color-text-muted)]">En exploración. Validando hipótesis y definiendo el producto.</p>
              </div>
            </div>
          </div>

          <!-- Stats -->
          <div class="mt-8 pt-6 border-t border-[var(--color-border-subtle)] grid grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-2xl font-bold gradient-text">3</div>
              <div class="text-xs text-[var(--color-text-muted)]">Proyectos</div>
            </div>
            <div>
              <div class="text-2xl font-bold gradient-text">1</div>
              <div class="text-xs text-[var(--color-text-muted)]">Lanzamiento</div>
            </div>
            <div>
              <div class="text-2xl font-bold gradient-text">2025</div>
              <div class="text-xs text-[var(--color-text-muted)]">Activo</div>
            </div>
          </div>
        </div>
      </div>

      <!-- MYTHOS Card (spans 5 cols) -->
      <article class="lg:col-span-5 group relative reveal" data-project="mythos">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-amber-500 to-orange-600 rounded-3xl opacity-0 group-hover:opacity-100 blur transition-all duration-500"></div>
        <div class="relative h-full bg-[var(--color-surface-primary)] rounded-3xl border border-[var(--color-border)] overflow-hidden transition-all duration-300 group-hover:border-transparent">
          <div class="absolute top-0 left-0 w-48 h-48 bg-gradient-to-br from-amber-500/10 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>

          <div class="relative p-8">
            <!-- Header -->
            <div class="flex items-center gap-3 mb-4">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shadow-lg shadow-amber-500/25">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-[var(--color-text-primary)]">MYTHOS</h3>
                <p class="text-amber-500 text-sm font-medium">Historias que vale la pena construir</p>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-500 text-xs font-semibold border border-amber-500/20">
                Building
              </span>
            </div>

            <p class="text-[var(--color-text-secondary)] mb-6">{projects[1].description}</p>

            <!-- Key features as mini cards -->
            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="p-3 rounded-xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)]">
                <div class="text-xs text-amber-500 font-semibold mb-1">IA Integrada</div>
                <div class="text-xs text-[var(--color-text-muted)]">Homero, Calíope, Pythia</div>
              </div>
              <div class="p-3 rounded-xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)]">
                <div class="text-xs text-amber-500 font-semibold mb-1">Comunidad</div>
                <div class="text-xs text-[var(--color-text-muted)]">Validación temprana</div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-4">
              <div class="flex gap-1.5">
                {projects[1].tech.slice(0, 3).map(t => (
                  <span class="px-2 py-1 rounded bg-amber-500/10 text-amber-600 text-xs font-mono">{t}</span>
                ))}
              </div>
              <a
                href="https://mythos.iumotionlabs.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white text-sm font-semibold shadow-lg shadow-amber-500/25 hover:shadow-xl hover:shadow-amber-500/30 hover:scale-105 transition-all"
              >
                Explorar
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- FAMILY CARE Card (spans 7 cols) -->
      <article class="lg:col-span-7 group relative reveal" data-project="familycare">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-violet-500 to-purple-600 rounded-3xl opacity-0 group-hover:opacity-100 blur transition-all duration-500"></div>
        <div class="relative bg-[var(--color-surface-primary)] rounded-3xl border border-[var(--color-border)] overflow-hidden transition-all duration-300 group-hover:border-transparent">
          <div class="absolute bottom-0 right-0 w-64 h-64 bg-gradient-to-tl from-violet-500/10 to-transparent rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>

          <div class="relative p-8 lg:p-10">
            <div class="flex flex-col lg:flex-row lg:items-start gap-6">
              <!-- Left content -->
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg shadow-violet-500/25">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-[var(--color-text-primary)]">FAMILY CARE</h3>
                    <p class="text-violet-500 text-sm font-medium">El cuidado de toda tu familia</p>
                  </div>
                </div>

                <p class="text-[var(--color-text-secondary)] mb-6">{projects[2].description}</p>

                <div class="flex flex-wrap gap-2">
                  {projects[2].highlights.slice(0, 4).map(h => (
                    <span class="px-3 py-1.5 rounded-lg bg-violet-500/10 text-sm text-violet-500 border border-violet-500/20">
                      {h}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Right card - Concept status -->
              <div class="lg:w-48 p-4 rounded-2xl bg-[var(--color-surface-secondary)] border border-[var(--color-border-subtle)]">
                <div class="flex items-center gap-2 mb-3">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-violet-500/10 text-violet-500 text-xs font-semibold border border-violet-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></span>
                    Concept Lab
                  </span>
                </div>
                <p class="text-xs text-[var(--color-text-muted)] mb-3">En fase de exploración y diseño. Validando la propuesta de valor.</p>
                <div class="text-xs text-[var(--color-text-muted)]">
                  <span class="text-[var(--color-text-secondary)]">Tipo:</span> App Móvil
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  [data-project]:hover {
    z-index: 10;
  }
</style>
