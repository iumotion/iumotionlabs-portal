---

---

<section id="inicio" class="relative min-h-screen flex items-center pt-16 hero-pattern overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 right-1/4 w-72 h-72 bg-[var(--color-accent-start)] opacity-5 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-[var(--color-accent-end)] opacity-5 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-surface-secondary)] border border-[var(--color-border)] mb-8 reveal">
        <span class="w-2 h-2 rounded-full bg-[var(--color-launchpad)] animate-pulse"></span>
        <span class="text-sm font-medium text-[var(--color-text-secondary)]">
          Laboratorio de Innovación
        </span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 reveal">
        <span class="text-[var(--color-text-primary)]">Transformamos</span>
        <br />
        <span class="gradient-text">ideas en productos</span>
        <br />
        <span class="text-[var(--color-text-primary)]">de alto impacto</span>
      </h1>

      <!-- Subheading -->
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-10 reveal">
        En IumotionLabs exploramos el futuro a través de la tecnología.
        Diseñamos, construimos y lanzamos productos digitales que resuelven
        problemas reales con excelencia técnica y visión de largo plazo.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal">
        <a
          href="#portafolio"
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl gradient-bg text-white font-semibold text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all glow"
        >
          Explorar Portafolio
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-[var(--color-surface-secondary)] border border-[var(--color-border)] text-[var(--color-text-primary)] font-semibold text-lg hover:bg-[var(--color-surface-tertiary)] hover:border-[var(--color-accent-start)] transition-all"
        >
          Contactar
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-8 mt-20 pt-12 border-t border-[var(--color-border-subtle)] reveal">
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-bold gradient-text">3</div>
          <div class="text-sm text-[var(--color-text-muted)] mt-1">Proyectos Activos</div>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-bold gradient-text">100%</div>
          <div class="text-sm text-[var(--color-text-muted)] mt-1">Enfoque en Calidad</div>
        </div>
        <div class="text-center">
          <div class="text-3xl sm:text-4xl font-bold gradient-text">2025</div>
          <div class="text-sm text-[var(--color-text-muted)] mt-1">Fundación</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
