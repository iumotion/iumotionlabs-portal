---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const {
  title,
  description = "Laboratorio de innovación digital que transforma ideas en productos de alto impacto. Desarrollamos apps móviles, plataformas web y ecosistemas tecnológicos con Flutter, Angular, Go y AWS.",
  keywords = "laboratorio innovación digital, desarrollo apps móviles, desarrollo web, Flutter, Angular, Go, AWS, startup tecnología, productos digitales, fintech, gestión familiar, Bogotá Colombia"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="IumotionLabs" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Geo Tags -->
    <meta name="geo.region" content="CO-DC" />
    <meta name="geo.placename" content="Bogotá" />
    <meta name="geo.position" content="4.7110;-74.0721" />
    <meta name="ICBM" content="4.7110, -74.0721" />

    <!-- Favicons - Complete set for all browsers and Google -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Microsoft Tiles -->
    <meta name="msapplication-TileColor" content="#6366f1" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="IumotionLabs - Laboratorio de Innovación Digital" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="IumotionLabs" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@iumotionlabs" />
    <meta name="twitter:creator" content="@iumotionlabs" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="IumotionLabs - Laboratorio de Innovación Digital" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

    <!-- DNS Prefetch & Preconnect for external resources -->
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://linkedin.com" />
    <link rel="dns-prefetch" href="https://mythos.iumotionlabs.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />

    <!-- Preload Critical Assets -->
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://iumotionlabs.com/#organization",
          "name": "IumotionLabs",
          "alternateName": "Iumotion Labs",
          "url": "https://iumotionlabs.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://iumotionlabs.com/logo.svg",
            "width": 512,
            "height": 512
          },
          "image": "https://iumotionlabs.com/og-image.jpg",
          "description": description,
          "foundingDate": "2025",
          "founder": {
            "@type": "Person",
            "name": "IumotionLabs Team"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bogotá",
            "addressCountry": "CO"
          },
          "sameAs": [
            "https://github.com/iumotion",
            "https://linkedin.com/company/iumotionlabs"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "hello@iumotionlabs.com",
            "contactType": "customer service",
            "availableLanguage": ["Spanish", "English"]
          },
          "knowsAbout": [
            "Desarrollo de aplicaciones móviles",
            "Flutter",
            "Angular",
            "Go",
            "AWS",
            "Inteligencia Artificial",
            "Fintech",
            "Productos digitales"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://iumotionlabs.com/#website",
          "url": "https://iumotionlabs.com",
          "name": "IumotionLabs",
          "description": description,
          "publisher": {
            "@id": "https://iumotionlabs.com/#organization"
          },
          "inLanguage": "es-CO"
        },
        {
          "@type": "WebPage",
          "@id": "https://iumotionlabs.com/#webpage",
          "url": "https://iumotionlabs.com",
          "name": title,
          "description": description,
          "isPartOf": {
            "@id": "https://iumotionlabs.com/#website"
          },
          "about": {
            "@id": "https://iumotionlabs.com/#organization"
          },
          "inLanguage": "es-CO",
          "datePublished": "2025-01-01",
          "dateModified": new Date().toISOString().split('T')[0]
        },
        {
          "@type": "SoftwareApplication",
          "name": "SAVVY",
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "iOS, Android",
          "description": "Tu copiloto financiero personal. Toma el control de tus finanzas con inteligencia y privacidad.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "creator": {
            "@id": "https://iumotionlabs.com/#organization"
          }
        },
        {
          "@type": "SoftwareApplication",
          "name": "MYTHOS",
          "applicationCategory": "BusinessApplication",
          "url": "https://mythos.iumotionlabs.com",
          "description": "Plataforma de construcción narrativa aplicada a innovación. Transforma ideas en proyectos ejecutables.",
          "creator": {
            "@id": "https://iumotionlabs.com/#organization"
          }
        },
        {
          "@type": "SoftwareApplication",
          "name": "FAMILY CARE",
          "applicationCategory": "HealthApplication",
          "operatingSystem": "iOS, Android",
          "description": "Desde bebés hasta abuelos. Centraliza salud, rutinas y coordinación familiar.",
          "creator": {
            "@id": "https://iumotionlabs.com/#organization"
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="skip-link">
      Saltar al contenido principal
    </a>

    <slot />

    <!-- Theme Toggle Script -->
    <script>
      // Theme management with system preference support
      const getThemePreference = (): 'light' | 'dark' => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
      };

      // Apply theme immediately to prevent flash
      setTheme(getThemePreference());

      // Listen for system preference changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          setTheme(e.matches ? 'dark' : 'light');
        }
      });

      // Expose toggle function globally
      (window as any).toggleTheme = () => {
        const current = document.documentElement.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      };
    </script>

    <!-- Scroll Reveal Animation Script -->
    <script>
      // IntersectionObserver for scroll-reveal animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      const handleIntersect: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      // Check for reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const observer = new IntersectionObserver(handleIntersect, observerOptions);

        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.reveal, .stagger-children').forEach(el => {
            observer.observe(el);
          });
        });
      } else {
        // Show all elements immediately if reduced motion is preferred
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.reveal, .stagger-children').forEach(el => {
            el.classList.add('is-visible');
          });
        });
      }
    </script>
  </body>
</html>
